{
  "name": "lukis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": "24.x",
    "pnpm": "11.1.1"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "deploy": "pnpm build && wrangler deploy --strict",
    "deploy:check": "pnpm build && wrangler deploy --dry-run --strict",
    "start": "astro preview",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "typecheck": "astro check",
    "test": "node --test test/*.test.ts",
    "test:browser": "node --test test/browser.test.ts && LUKIS_TEST_RENDERER=webgl2 node --test test/browser.test.ts",
    "test:gpu": "node test/gpu-verification.ts && LUKIS_TEST_RENDERER=webgl2 node test/gpu-verification.ts && LUKIS_TEST_RENDERER=webgl2-rgba8 node test/gpu-verification.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:gpu && pnpm build"
  },
  "dependencies": {
    "animejs": "4.5.0",
    "cuelume": "0.2.2",
    "dialkit": "2.0.0",
    "number-flow": "0.6.2",
    "vgpu": "0.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.62.1",
    "@tabler/icons": "3.41.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.3",
    "@webgpu/types": "0.1.72",
    "astro": "7.2.9",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "wrangler": "4.127.1"
  }
}
