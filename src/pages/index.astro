---
import "../styles/global.css";
import Button from "../components/Button.astro";
import ElasticSlider from "../components/ElasticSlider.astro";
import UploadPreview from "../components/UploadPreview.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import Refresh from "@tabler/icons/outline/refresh.svg";
import Download from "@tabler/icons/outline/download.svg";
import Copy from "@tabler/icons/outline/copy.svg";
import { THEME_SCRIPT } from "../lib/theme";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Lukis — Turn images into paintings</title>
    <meta name="description" content="Turn your images into paintings. Adjust the brush and paint, then download a PNG. Processed privately in your browser." />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Lukis — Turn images into paintings" />
    <meta property="og:description" content="Turn your images into paintings. Adjust the brush and paint, then download a PNG. Processed privately in your browser." />
    <meta property="og:image" content="https://lukis-two.vercel.app/og.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The silver Lukis logo, tilted on a dark background." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://lukis-two.vercel.app/og.png" />
    <meta name="twitter:image:alt" content="The silver Lukis logo, tilted on a dark background." />
    <meta name="theme-color" content="#171717" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=2" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/sunghyun-sans/SunghyunSans-Regular.subset.0.woff2" crossorigin />
    <script is:inline set:html={THEME_SCRIPT} />
  </head>
  <body class="font-sans antialiased">
    <div class="ds-root min-h-svh bg-background text-foreground">
      <main class="app-main grid min-h-svh grid-cols-1 place-items-center p-(--page-padding)">
        <section class="tool-surface relative isolate w-full max-w-4xl" aria-label="Lukis image processor">
          <input id="image-input" type="file" accept="image/png,image/jpeg,image/webp" aria-hidden="true" tabindex="-1" class="sr-only" />
          <div class="result w-full">
            <UploadPreview />
            <div class="controls-space h-0" hidden>
              <div class="controls relative top-6 m-auto grid gap-4 px-2 compact:top-4" inert>
                <div class="control-row w-full max-w-lg justify-self-center"><ElasticSlider label="Paint" min={0} max={100} step={1} value={78} suffix="%" notches={[10, 20, 30, 40, 50, 60, 70, 80, 90]} /></div>
                <div class="control-row w-full max-w-lg justify-self-center"><ElasticSlider label="Brush" min={0.7} max={3} step={0.1} value={1.4} notches={[1, 1.5, 2, 2.5]} /></div>
                <div class="control-actions flex w-full max-w-lg items-center justify-between justify-self-center">
                  <Button id="restart" label="Restart with another image" title="Restart" variant="secondary" size="icon"><Refresh slot="icon" /></Button>
                  <div class="export-actions flex items-center gap-2" role="group" aria-label="Save image">
                    <Button id="download" label="Download painterly PNG" title="Download PNG" variant="secondary" size="icon" feedback><Download slot="icon" /></Button>
                    <Button id="copy" label="Copy painterly PNG" title="Copy PNG" variant="secondary" size="icon" feedback><Copy slot="icon" /></Button>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <p class="status sr-only" aria-live="polite" aria-atomic="true"></p>
          <noscript><p>Enable JavaScript to process images in Lukis.</p></noscript>
        </section>
      </main>
      <ThemeToggle />
    </div>
    <script>import { mountApp } from "../lib/app"; mountApp();</script>
  </body>
</html>
