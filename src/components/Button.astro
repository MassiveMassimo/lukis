---
// Adapted from Fluid Functionalism. See licenses/fluid-functionalism.txt.
import type { HTMLAttributes } from "astro/types";
import AnimatedCheck from "./AnimatedCheck.astro";

interface Props extends HTMLAttributes<"button"> {
  label: string;
  variant?: "primary" | "secondary" | "tertiary" | "ghost";
  size?: "default" | "compact" | "icon" | "icon-compact";
  loading?: boolean;
  feedback?: boolean;
}

const {
  label,
  variant = "primary",
  size = "default",
  loading = false,
  feedback = false,
  disabled = false,
  type = "button",
  class: className,
  ...attributes
} = Astro.props;
const iconOnly = size === "icon" || size === "icon-compact";
const leadingIcon = Astro.slots.has("icon");
const trailingIcon = Astro.slots.has("trailing-icon");
const sizeClasses = {
  default: "h-9 gap-1.5 px-4 text-[13px]",
  compact: "h-7 gap-1 px-3 text-xs",
  icon: "size-9 gap-1.5 p-0 text-base",
  "icon-compact": "size-7 gap-1.5 p-0 text-base",
};
---

<button
  {...attributes}
  type={type}
  class:list={[
    "fluid-button relative isolate inline-flex cursor-pointer appearance-none items-center justify-center rounded-control border-0 bg-transparent font-sans leading-normal outline-none transition-colors duration-[80ms] disabled:pointer-events-none focus-visible:outline-1 focus-visible:outline-offset-2 focus-visible:outline-solid focus-visible:outline-focus-ring motion-reduce:transition-none",
    sizeClasses[size],
    !iconOnly && leadingIcon && (size === "compact" ? "pl-1.5" : "pl-2.5"),
    !iconOnly && trailingIcon && (size === "compact" ? "pr-1.5" : "pr-2.5"),
    className,
  ]}
  data-variant={variant}
  data-size={size}
  data-loading={String(loading)}
  data-feedback={String(feedback)}
  data-idle-disabled={String(disabled)}
  data-leading-icon={leadingIcon}
  data-trailing-icon={trailingIcon}
  aria-label={attributes["aria-label"] ?? (iconOnly ? label : undefined)}
  aria-busy={loading ? "true" : undefined}
  disabled={disabled || loading}
>
  <span class="surface absolute inset-px rounded-[inherit] bg-(--button-fill)" data-button-background aria-hidden="true"></span>
  <span class="content relative inline-flex items-center justify-center gap-[inherit]">
    <span class="idle-content relative inline-flex items-center justify-center gap-[inherit]" data-button-icon={feedback ? "idle" : undefined}>
      {leadingIcon && <span class="icon inline-flex" aria-hidden="true"><slot name="icon" /></span>}
      {!iconOnly && <span class="label whitespace-nowrap [text-box:trim-both_cap_alphabetic]">{label}</span>}
      {trailingIcon && <span class="icon inline-flex" aria-hidden="true"><slot name="trailing-icon" /></span>}
    </span>
    {!feedback && <span class="spinner absolute inset-0 hidden items-center justify-center" aria-hidden="true">
      <svg class:list={["shrink-0", size === "compact" || size === "icon-compact" ? "size-7" : "size-9"]} viewBox="0 0 24 24" fill="none">
        <path
          d="M 12 12 C 14 8.5 19 8.5 19 12 C 19 15.5 14 15.5 12 12 C 10 8.5 5 8.5 5 12 C 5 15.5 10 15.5 12 12 Z"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          pathLength="100"
        ></path>
      </svg>
    </span>}
    {feedback && <span class="success icon inline-flex" data-button-icon="success" hidden aria-hidden="true"><AnimatedCheck /></span>}
  </span>
</button>

<style>
  .fluid-button {
    --button-fill: var(--foreground, #171717);
    --button-ring: var(--button-fill);
    color: var(--background, #fff);
  }

  .surface {
    box-shadow: 0 0 0 1px var(--button-ring);
    transition:
      box-shadow 180ms cubic-bezier(0.23, 1, 0.32, 1),
      background-color 80ms ease;
  }

  .fluid-button:active .surface {
    box-shadow: 0 0 0 0 var(--button-ring);
    transition-duration: 80ms, 80ms;
  }

  .fluid-button[data-variant="primary"]:hover {
    --button-fill: color-mix(in oklab, var(--foreground, #171717) 90%, var(--background, #fff));
  }

  .fluid-button[data-variant="primary"]:active {
    --button-fill: color-mix(in oklab, var(--foreground, #171717) 80%, var(--background, #fff));
  }

  .fluid-button[data-variant="secondary"] {
    --button-fill: var(--accent, #eee);
    color: var(--foreground, #171717);
  }

  .fluid-button[data-variant="secondary"]:hover {
    --button-fill: color-mix(in oklab, var(--accent, #eee) 80%, var(--background, #fff));
  }

  .fluid-button[data-variant="secondary"]:active {
    --button-fill: var(--accent, #eee);
  }

  .fluid-button[data-variant="tertiary"],
  .fluid-button[data-variant="ghost"] {
    --button-fill: transparent;
    --button-ring: transparent;
    color: var(--foreground, #171717);
  }

  .fluid-button[data-variant="ghost"] {
    color: var(--muted-foreground, #666);
  }

  .fluid-button[data-variant="tertiary"] .surface {
    box-shadow: 0 0 0 1px var(--border, #ddd), inset 0 0 0 0 var(--border, #ddd);
  }

  .fluid-button[data-variant="tertiary"]:hover,
  .fluid-button[data-variant="ghost"]:hover {
    --button-fill: var(--hover, #0000000a);
    --button-ring: var(--hover, #0000000a);
    color: var(--foreground, #171717);
  }

  .fluid-button[data-variant="tertiary"]:active,
  .fluid-button[data-variant="ghost"]:active {
    --button-fill: var(--active, #00000014);
    --button-ring: var(--active, #00000014);
  }

  .fluid-button[data-variant="tertiary"]:active .surface {
    box-shadow: 0 0 0 0 var(--border, #ddd), inset 0 0 0 1px var(--border, #ddd);
  }

  .icon :global(svg) {
    width: 16px;
    height: 16px;
    stroke-width: 1.5;
    transition: stroke-width 80ms;
  }

  .fluid-button:hover .icon :global(svg) {
    stroke-width: 2;
  }

  .fluid-button[data-size="compact"] .icon :global(svg),
  .fluid-button[data-size="icon-compact"] .icon :global(svg) { width: 14px; height: 14px; }

  .fluid-button[data-feedback="false"][data-loading="true"] .idle-content { opacity: 0; }
  .fluid-button[data-loading="true"] .spinner { display: flex; }
  .fluid-button[data-feedback="true"] .content { width: 100%; height: 100%; }
  .fluid-button[data-feedback="true"] [data-button-icon] {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .fluid-button[data-feedback="true"] [data-button-icon][hidden] { display: none; }
  .spinner path { stroke-dasharray: 15 85; }
  .fluid-button[data-loading="true"] .spinner path {
    animation: spinner-move 2s linear infinite, spinner-dash 4s ease-in-out infinite;
  }

  @keyframes spinner-move { to { stroke-dashoffset: -100; } }
  @keyframes spinner-dash { 0%, 100% { stroke-dasharray: 15 85; } 50% { stroke-dasharray: 40 60; } }

  @media (prefers-reduced-motion: reduce) {
    .fluid-button, .surface, .icon :global(svg) { transition: none; }
    .fluid-button[data-loading="true"] .spinner path { animation: none; stroke-dasharray: none; }
  }
</style>
